* text=auto

# Deployment and container files must keep Unix line endings after a Windows checkout.
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf

# Never apply text normalization to binary assets.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
