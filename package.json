{
  "name": "eduri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare:client-assets": "node scripts/copy-client-runtime-assets.mjs",
    "dev": "npm run dev:replica",
    "dev:replica": "npm run build && node scripts/dev-replica.mjs",
    "dev:fast": "npm run prepare:client-assets && concurrently -k -n call,api,web -c magenta,green,blue \"node scripts/dev-livekit.mjs\" \"cross-env NODE_ENV=development tsx watch src/server/index.ts\" \"vite\"",
    "dev:call": "node scripts/dev-livekit.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm run prepare:client-assets && vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "cross-env NODE_ENV=production node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:board-compaction": "tsx scripts/benchmark-board-document-compaction.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.23",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fractional-indexing": "3.2.0",
    "helmet": "^8.1.0",
    "konva": "10.3.0",
    "lib0": "0.2.117",
    "livekit-client": "^2.20.2",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.1",
    "rbush": "4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "sharp": "0.35.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "8.21.1",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/rbush": "4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^29.1.1",
    "monaco-editor": "0.55.1",
    "pyodide": "0.27.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "monaco-editor": {
      "dompurify": "3.4.13"
    }
  }
}
